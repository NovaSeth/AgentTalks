#!/bin/bash
# Hook adapter for `talk`. Delivers messages from other sessions DIRECTLY TO THE CONTEXT,
# so manual polling is unnecessary.
#
#   SessionStart -> talk-hook start   (registration + who is online)
#   PostToolUse  -> talk-hook tick    (heartbeat + delivery of new messages)
#   SessionEnd   -> talk-hook end     (farewell)
#
# CRITICAL: tick runs after EVERY tool, so the "nothing new" path must be
# cheap - just compare mtime without starting Python (saves ~30 ms per call).

set -uo pipefail
TALK=/home/claude/second-brain/bin/talk
ROOT=/home/claude/.talk
CHAN="$ROOT/channel.jsonl"
MODE="${1:-}"

payload=$(cat 2>/dev/null || true)
# sed, not python: this hook runs after every tool, and starting Python takes ~30 ms.
sid=$(printf '%s' "$payload" \
  | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
[ -n "$sid" ] && export TALK_SID="$sid"

emit() {   # $1 = text to inject into the model's context
  python3 -c '
import json,sys
t=sys.stdin.read().strip()
if t:
    print(json.dumps({"hookSpecificOutput":{
        "hookEventName":"'"$2"'","additionalContext":t}}))
' <<< "$1"
}

case "$MODE" in
  start)
    "$TALK" join >/dev/null 2>&1
    info=$("$TALK" who 2>/dev/null)
    openq=$("$TALK" open 2>/dev/null | grep -v '^No open questions' || true)
    emit "THE INTERSESSION CHANNEL (talk) is active. Your ID: ${sid:0:8}
$info
${openq:+
OPEN QUESTIONS - you can pick up any of them; they do not have to be addressed to you:
$openq
}
Michal (label 'Michał') is also a channel participant - he writes from the browser UI
(https://nestor.monokoda.com/talk). You can ask him just like any other session:
  talk to Michał <question>      - directly to him
  talk ask #channel <question>  - an open question, answered by him or another session

More: talk say <text>, talk in #channel <text>, talk who, talk log,
talk watch #channel, talk react <mid> <emoji>.
The channel is not deleted (since 2026-07-30), but it is not persistent knowledge - save facts to ~/second-brain." SessionStart
    ;;

  tick)
    # `busy`, not `ping`: tool use is the session's equivalent of "typing...".
    # The signal MUST come from work, not API polling - otherwise an open
    # browser tab would pretend the human was working.
    "$TALK" busy >/dev/null 2>&1 &     # in the background, does not block the tool
    # Fast path: has anything arrived since the last read?
    cur="$ROOT/cursor/${TALK_SID:-none}"
    [ -f "$CHAN" ] || exit 0
    if [ -f "$cur" ] && [ ! "$CHAN" -nt "$cur" ]; then exit 0; fi
    new=$("$TALK" read 2>/dev/null | grep -v '^No new messages' || true)
    [ -n "$new" ] || exit 0
    emit "NEW MESSAGES FROM OTHER SESSIONS (talk channel):
$new

Reply: /usr/local/bin/talk say <text>  or  talk to <label> <text>
(the script is on PATH as talk - fixed on 2026-07-30 after session 7c18adbe reported it)" PostToolUse
    ;;

  end)
    "$TALK" leave >/dev/null 2>&1
    ;;
esac
exit 0
