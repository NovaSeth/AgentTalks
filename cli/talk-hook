#!/bin/bash
# Adapter hookow dla `talk`. Dostarcza wiadomosci od innych sesji WPROST DO KONTEKSTU,
# zeby nie trzeba bylo pollowac recznie.
#
#   SessionStart -> talk-hook start   (rejestracja + kto jest online)
#   PostToolUse  -> talk-hook tick    (heartbeat + dostawa nowych wiadomosci)
#   SessionEnd   -> talk-hook end     (pozegnanie)
#
# KRYTYCZNE: tick odpala sie po KAZDYM narzedziu, wiec sciezka "nic nowego" musi byc
# tania - samo porownanie mtime, bez startu Pythona (~30 ms oszczednosci na wywolanie).

set -uo pipefail
TALK=/home/claude/second-brain/bin/talk
ROOT=/home/claude/.talk
CHAN="$ROOT/channel.jsonl"
MODE="${1:-}"

payload=$(cat 2>/dev/null || true)
# sed, nie python: ten hook odpala sie po kazdym narzedziu, a start Pythona to ~30 ms.
sid=$(printf '%s' "$payload" \
  | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
[ -n "$sid" ] && export TALK_SID="$sid"

emit() {   # $1 = tekst do wstrzykniecia w kontekst modelu
  python3 -c '
import json,sys
t=sys.stdin.read().strip()
if t:
    print(json.dumps({"hookSpecificOutput":{
        "hookEventName":"'"$2"'","additionalContext":t}}))
' <<< "$1"
}

case "$MODE" in
  start)
    "$TALK" join >/dev/null 2>&1
    info=$("$TALK" who 2>/dev/null)
    openq=$("$TALK" open 2>/dev/null | grep -v '^Brak otwartych' || true)
    emit "KANAL MIEDZYSESYJNY (talk) jest aktywny. Twoje ID: ${sid:0:8}
$info
${openq:+
OTWARTE PYTANIA - mozesz podjac ktorekolwiek, nie musi byc adresowane do Ciebie:
$openq
}
Michal (label 'Michał') tez jest uczestnikiem kanalu - pisze z UI w przegladarce
(https://nestor.monokoda.com/talk). Mozesz go zapytac jak kazda inna sesje:
  talk to Michał <pytanie>        - bezposrednio do niego
  talk ask #kanal <pytanie>       - otwarte pytanie, odpowie on albo inna sesja

Reszta: talk say <tekst>, talk in #kanal <tekst>, talk who, talk log,
talk watch #kanal, talk react <mid> <emoji>.
Kanal nie jest kasowany (od 2026-07-30), ale nie jest wiedza trwala - fakty zapisuj do ~/second-brain." SessionStart
    ;;

  tick)
    # `busy`, nie `ping`: uzycie narzedzia to odpowiednik "pisze..." dla sesji.
    # Sygnal MUSI pochodzic z pracy, nie z pollowania API - inaczej otwarta karta
    # przegladarki udawalaby, ze czlowiek pracuje.
    "$TALK" busy >/dev/null 2>&1 &     # w tle, nie blokuje narzedzia
    # szybka sciezka: czy w ogole cokolwiek doszlo od ostatniego odczytu?
    cur="$ROOT/cursor/${TALK_SID:-none}"
    [ -f "$CHAN" ] || exit 0
    if [ -f "$cur" ] && [ ! "$CHAN" -nt "$cur" ]; then exit 0; fi
    new=$("$TALK" read 2>/dev/null | grep -v '^Brak nowych' || true)
    [ -n "$new" ] || exit 0
    emit "NOWE WIADOMOSCI OD INNYCH SESJI (kanal talk):
$new

Odpowiedz: /usr/local/bin/talk say <tekst>  albo  talk to <label> <tekst>
(skrypt jest w PATH jako talk - fix 2026-07-30 po zgloszeniu sesji 7c18adbe)" PostToolUse
    ;;

  end)
    "$TALK" leave >/dev/null 2>&1
    ;;
esac
exit 0
