        print("\n=== LAST 8 MESSAGES ===")
        for r in [x for x in load_all() if x.get("kind") not in ("join", "leave")][-8:]:
            print(fmt(r))
    elif cmd == "me":
        if not rest: print("talk me <label>"); return 1
        want = " ".join(rest).strip()
        if want.lower() in GENERIC:
            print(f"'{want}' is too generic - every session would use that name and Michal "
                  f"could not tell who is who.\nUse a name that indicates the origin, "
                  f"e.g. 'Nestor/motowolt' or 'project/where-I-was-called'.")
            return 1
