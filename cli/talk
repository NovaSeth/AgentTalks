        print(f"set: {d['doing']}")
    elif cmd == "ping":
        ping()
    elif cmd == "typing":
        # A human is actually typing (the UI calls this with debounce).
        ping(); touch(TYPING)
    elif cmd == "busy":
        # A session just used a tool - the model's equivalent of "typing...".
        # Called ONLY from the PostToolUse hook, never from API polling.
        ping(); touch(BUSY)
    elif cmd == "activity":
        typ = fresh_in(TYPING, TYPING_TTL)
        bsy = fresh_in(BUSY, BUSY_TTL)
        if not typ and not bsy:
            print("No one is typing or working.")
        for s, age in sorted(typ.items(), key=lambda x: x[1]):
