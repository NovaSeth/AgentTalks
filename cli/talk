#!/usr/bin/env python3
"""talk - an ephemeral communication channel between parallel Claude Code sessions.

HOW IT DIFFERS FROM THE WIKI: the wiki (~/second-brain) is PERSISTENT memory, versioned with git -
facts that must survive belong there. This is a conversation: questions, opinions, "I am
working on X, leave it alone", "I checked Y, the result was Z". Ephemeral means "not persistent knowledge", but history is NOT deleted
(deletion disabled on 2026-07-30 at Michal's request). It is NOT in git. It keeps ongoing chatter out of the knowledge base.

WHY ~/.talk INSTEAD OF /tmp: nestor.service has PrivateTmp=true, so /tmp is NOT
shared between sessions. All sessions run as user claude, so ~/.talk works.

MODEL: one shared channel (like a chat room) + a presence registry.
Each session has a cursor; the hook delivers new messages to the context automatically,
so manual polling is unnecessary.
"""
import fcntl, json, os, re, sys, time, glob, base64

# TALK_HOME lets tests use a temporary directory instead of the live channel.
# Without it, each test would add junk to Michal's conversation and break the counters.
ROOT = os.environ.get("TALK_HOME") or os.path.expanduser("~/.talk")
CHAN = os.path.join(ROOT, "channel.jsonl")
PRES = os.path.join(ROOT, "presence")
CURS = os.path.join(ROOT, "cursor")
LOCK = os.path.join(ROOT, "lock")

MSG_TTL = 24 * 3600      # messages older than 24h are cleaned up
ONLINE_WINDOW = 900      # no heartbeat for > 15 min = session considered inactive
TYPING_TTL = 7           # "typing..." fades after 7 s without another signal
BUSY_TTL = 30            # "working" = used a tool in the last 30 s

# Two DIFFERENT signals, intentionally separate:
#   typing/ - a human is actually typing in the UI
#   busy/   - a session has just used a tool (written by the PostToolUse hook, NOT by
#             API polling - otherwise an open browser tab would pretend to be working)
TYPING = os.path.join(ROOT, "typing")
BUSY = os.path.join(ROOT, "busy")

# Storage for files sent through the channel. Created on demand (not in the loop below),
# since most sessions never send a file - there is no reason to create an empty directory.
FILES = os.path.join(ROOT, "files")

for d in (ROOT, PRES, CURS):
    os.makedirs(d, exist_ok=True)


class Lock:
    def __enter__(self):
        self.f = open(LOCK, "a+")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self
    def __exit__(self, *a):
        fcntl.flock(self.f, fcntl.LOCK_UN); self.f.close()


def _pstat(pid):
    # /proc/<pid>/stat fields AFTER the comm field (which may contain spaces/parentheses):
    # [0]=state [1]=ppid [2]=pgrp [3]=session ... [19]=starttime
    return open("/proc/%d/stat" % pid).read().rsplit(")", 1)[1].split()


def sid():
    s = os.environ.get("TALK_SID") or os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    s = s.strip()
    if s:
        return s
    # Sessions without a startup hook (deploy-runner, batch-analyst, cron-nocturne, pair-live,
    # watchdog - 2026-08-03) shared the literal "unknown": they wrote to one presence file,
    # overwriting each other, and could neither register (`talk me`) nor
    # lock a resource. Fallback: a stable, unique token from the GRANDPARENT process (the persistent
    # session process; its PID is identical across separate talk calls from the same session,
    # but differs between sessions - measured: getsid/pgid/ppid change, the grandparent does not) plus
    # its start time (in case the PID is recycled after a reboot). A cron job/test run in a clean
    # environment has a shell/crond grandparent that disappears - this is fine: the presence entry
    # becomes stale after 10 min (STALE_AFTER) and disappears, leaving no persistent phantom participant.
    try:
        gp = int(_pstat(os.getppid())[1])          # talk's grandparent = persistent session process
        if gp <= 1:
            return "unknown"
        starttime = _pstat(gp)[19]
        return "sess-%d-%s" % (gp, starttime)
    except Exception:
        return "unknown"


def short(s):
    return s[:8]


def label_of(s):
    p = os.path.join(PRES, s)
    try:
        return json.load(open(p)).get("label") or short(s)
    except Exception:
        return short(s)


# Names that say nothing about a session's origin. Michal needs to know WHO is who,
# and "claude" or "home" does not answer that question - every session would use that name.
GENERIC = {"claude", "home", "root", "workspace", "tmp", "usr", "var", "srv", "opt", ""}


def taken_labels(exclude_sid):
    """Labels taken by OTHER sessions: {label: sid}."""
    out = {}
    for p in glob.glob(os.path.join(PRES, "*")):
        b = os.path.basename(p)
        if b == exclude_sid or b.endswith(".tmp"):
            continue
        try:
            lbl = json.load(open(p)).get("label")
        except Exception:
            continue
        if lbl:
            out[lbl] = b
    return out


# Ephemeral = a session that ends by itself and cannot be returned to:
# one-shot calls through the bridge and subagent instances (the "bs/" prefix and similar roles).
# Adding suffixes to these names creates clutter, and showing them as alive for
# 10 minutes after they end is misleading - Michal reported this after seeing the list,
# where bs/user was still marked active 4 minutes after the instance ended.
#
# CAUTION about inferring from the NAME'S SHAPE: this is a heuristic, not a fact about the session.
# The kind should be declared at registration (TALK_KIND), which is how it
# works now - the name is only a fallback for recognizing older entries.
EPHEMERAL = ("/oneshot",)
EPHEMERAL_PREFIX = ("bs/",)
PRESENCE_TTL = 2 * 3600     # presence entry without a heartbeat longer than this -> removed
STALE_AFTER = 600           # 10 min without a heartbeat -> "last seen", not "live"
EPHEMERAL_STALE = 60        # one-shot: dead after ~a minute of silence, not 10


def is_ephemeral(label, rec=None):
    """Whether the session ends by itself and cannot be returned to.

    Order matters: FIRST the explicit declaration at registration (kind),
    only then the name heuristic. Inferring from the name's shape was
    the only mechanism until 2026-07-31, causing subagent instances ("bs/...")
    to pass for persistent sessions - shown as active for 10 minutes after ending.
    """
    if rec and rec.get("kind"):
        return rec["kind"] == "ephemeral"
    # Strip the " (N)" suffix BEFORE matching - entries from before the change are named
    # "Nestor/oneshot (3)" and otherwise would not match the pattern.
    base = re.sub(r"\s*\(\d+\)$", "", str(label))
    return (any(base.endswith(e) for e in EPHEMERAL)
            or any(base.startswith(p) for p in EPHEMERAL_PREFIX))


def unique_label(base, s):
    """The same project called repeatedly -> 'project (2)', 'project (3)'...
    Ephemeral sessions share a name - distinguishing them serves no purpose.

    Strip the suffix from the input so an already numbered name does not receive
    another number: `talk me "project (2)"` should yield "project (2)" or an available
    number, not "project (2) (3)". This path is real: a session can read
    its own label from `talk who` and declare it again.

    HONESTLY ABOUT ITS ORIGIN: I introduced this on 2026-07-31, thinking I was fixing
    an observed bug - but "alpha/project (2) (3)" in `talk since` output was
    the label "alpha/project (2)" with a COUNTER (3) beside it. I misread
    my own format. My own confirmation test passed both before and after
    the change, which should have stopped me immediately. The change stays because the path
    above is real, but it came from a mistake, not a measurement.
    """
    if is_ephemeral(base):
        return base
    base = re.sub(r"\s*\(\d+\)$", "", base)
    taken = taken_labels(s)
    if base not in taken:
        return base
    n = 2
    while f"{base} ({n})" in taken:
        n += 1
    return f"{base} ({n})"


def prune_presence():
    """Ended sessions do not leave the channel - there is no SessionEnd for
    a process that simply ended. Without this, the list grows monotonically
    and looks worse than reality (bug reported by Nestor/motowolt)."""
    now = time.time()
    for p in glob.glob(os.path.join(PRES, "*")):
        if os.path.basename(p) == "michal":
            continue                      # the human stays, even while asleep
        try:
            d = json.load(open(p))
        except Exception:
            continue
        age = now - (d.get("seen") or 0)
        # REMOVE ONLY EPHEMERAL SESSIONS. Named sessions stay, even when shown as
        # "quiet" - the mechanism was created to clean up finished one-shot calls, not
        # to forget participants.
        #
        # Bug on 2026-07-30 08:56: PRESENCE_TTL = 2 h removed MY live session's entry
        # after a night of inactivity. At the next ping, the label was derived from
        # the working directory, turning "Nestor/chat-vps" into "session/24f1a066" -
        # so Michal would have seen a new participant instead of the same session.
        # Cleaning up identities based on INACTIVITY is always wrong:
        # inactivity does not mean the end, and is normal for a session without a loop.
        if is_ephemeral(d.get("label", ""), d) and age > EPHEMERAL_STALE * 3:
            try:
                os.remove(p)
            except Exception:
                pass


def derive_label(s):
    """Automatic label: from the bridge, otherwise the project directory, never generic."""
    env_label = os.environ.get("TALK_LABEL", "").strip()
    if env_label:
        return unique_label(env_label, s)
    base = os.path.basename(os.getcwd())
    if base.lower() in GENERIC:
        # The project is unknown - better explicitly unknown than misleading.
        base = f"session/{short(s)}"
    return unique_label(base, s)


def ping(label=None):
    """Heartbeat + registration. File mtime = last activity."""
    s = sid()
    # Do not register presence without a known ID - otherwise every manual call
    # in a clean environment (e.g. from cron or a test) creates a phantom in `talk who`.
    if s == "unknown":
        return {"label": "unknown", "seen": time.time()}
    p = os.path.join(PRES, s)
    cur = {}
    try:
        cur = json.load(open(p))
    except Exception:
        pass
    if label:
        cur["label"] = unique_label(label, s)     # `talk me` - an explicit choice, but unique
    elif not cur.get("label") or cur.get("label", "").lower() in GENERIC:
        cur["label"] = derive_label(s)            # missing or generic -> derive
    # Kind declared explicitly at startup - better than guessing from the name.
    kind = os.environ.get("TALK_KIND", "").strip()
    if kind in ("ephemeral", "durable"):
        cur["kind"] = kind
    cur.setdefault("cwd", os.getcwd())
    cur.setdefault("since", time.time())
    cur["seen"] = time.time()
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cur, f)
    os.replace(tmp, p)
    return cur


DEFAULT_CHAN = "#general"


def touch(dirpath, s=None):
    os.makedirs(dirpath, exist_ok=True)
    p = os.path.join(dirpath, s or sid())
    with open(p, "w") as f:
        f.write(str(time.time()))
    return p


def fresh_in(dirpath, ttl):
    """Participants with a signal newer than ttl seconds -> {sid: age_in_seconds}."""
    out = {}
    if not os.path.isdir(dirpath):
        return out
    now = time.time()
    for p in glob.glob(os.path.join(dirpath, "*")):
        age = now - os.path.getmtime(p)
        if age < ttl:
            out[os.path.basename(p)] = age
    return out


def post(kind, text, to=None, chan=DEFAULT_CHAN, extra=None):
    s = sid()
    rec = {"ts": time.time(), "sid": s, "label": label_of(s),
           "kind": kind, "to": to, "chan": chan, "text": text}
    if extra:
        rec.update(extra)
    with Lock():
        # Assign all IDs UNDER THE LOCK, otherwise two sessions could receive the same one.
        existing = load_all()
        # Derive mid from the MAXIMUM, not the file length: after pruning/clearing history,
        # a len()-based counter would start issuing numbers that already exist,
        # attaching reactions to the wrong messages.
        top = 0
        for r in existing:
            m = str(r.get("mid") or "")
            if m.startswith("m") and m[1:].isdigit():
                top = max(top, int(m[1:]))
        rec["mid"] = "m%d" % (top + 1)
        if kind == "ask" and "id" in rec:
            # From the maximum, not a counter - after clearing history, a counter
            # would issue IDs that previously existed (the same bug as with mid).
            qtop = 0
            for r in existing:
                q = str(r.get("id") or "")
                if q.startswith("q") and q[1:].isdigit():
                    qtop = max(qtop, int(q[1:]))
            rec["id"] = "q%d" % (qtop + 1)
        with open(CHAN, "a") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    return rec


def reactions(mid):
    """Emoji attached to a message, grouped: {emoji: [who, ...]}."""
    out = {}
    for r in load_all():
        if r.get("kind") == "react" and r.get("ref") == mid:
            out.setdefault(r.get("emoji", "?"), []).append(r.get("label") or r.get("sid", "")[:8])
    return out


def open_items(chan=None):
    """Unanswered questions. The point of topic channels: a question
    addressed to a CHANNEL, not a particular session, can be picked up by anyone returning."""
    msgs = load_all()
    answered = {r.get("ref") for r in msgs if r.get("kind") == "answer"}
    out = []
    for r in msgs:
        if r.get("kind") != "ask" or r.get("id") in answered:
            continue
        if chan and (r.get("chan") or DEFAULT_CHAN) != chan:
            continue
        out.append(r)
    return out


def watched(s=None):
    p = os.path.join(PRES, s or sid())
    try:
        return json.load(open(p)).get("watch") or []
    except Exception:
        return []


def channels():
    """Channels from history + all watched channels + always #general.

    Watched channels count even when they do not have any messages yet -
    otherwise `talk watch #new` would create a channel invisible to everyone."""
    out = {DEFAULT_CHAN}
    for r in load_all():
        if r.get("chan"):
            out.add(r["chan"])
    for p in glob.glob(os.path.join(PRES, "*")):
        try:
            for c in (json.load(open(p)).get("watch") or []):
                out.add(c)
        except Exception:
            pass
    return sorted(out)


def load_all():
    out = []
    try:
        with open(CHAN) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    out.append(json.loads(line))
                except Exception:
                    pass
    except FileNotFoundError:
        pass
    return out


# --- file transfer through talk's own storage (no public HTTP) -----
# Bytes go to ~/.talk/files/<random-id>__<basename>, and the channel receives a
# kind='file' message with metadata. A remote Mac accesses this through SSH (running `talk`
# on this VPS), so the file never passes through a web server.
def _human(n):
    n = float(n or 0)
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{int(n)} B" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def file_records():
    """Map file_id -> kind='file' channel record (who uploaded it, when)."""
    out = {}
    for r in load_all():
        if r.get("kind") == "file" and r.get("file_id"):
            out[r["file_id"]] = r
    return out


def store_file(data, name, to=None):
    """Write bytes to storage and announce them in the channel. Returns file_id."""
    os.makedirs(FILES, exist_ok=True)
    fid = base64.urlsafe_b64encode(os.urandom(12)).decode().rstrip("=")
    base = os.path.basename(name) or "file"
    with open(os.path.join(FILES, fid + "__" + base), "wb") as f:
        f.write(data)
    size = len(data)
    post("file", f"{base} ({_human(size)})", to=to,
         extra={"file_id": fid, "name": base, "size": size})
    return fid


def find_file(fid):
    """Storage path for a file_id, or None."""
    hits = glob.glob(os.path.join(FILES, fid + "__*"))
    return hits[0] if hits else None


def fmt(r, mark=""):
    t = time.strftime("%H:%M:%S", time.localtime(r["ts"]))
    who = r.get("label") or short(r.get("sid", "?"))
    if r["kind"] == "join":
        return f"  {t}  * {who} joined the channel"
    if r["kind"] == "leave":
        return f"  {t}  * {who} left the channel"
    if r["kind"] == "react":
        # Deliver reactions clearly - that is their whole purpose as a signal to sessions.
        tgt = next((x for x in load_all() if x.get("mid") == r.get("ref")), None)
        frag = (tgt.get("text", "")[:45] + "...") if tgt and tgt.get("text") else r.get("ref", "?")
        return f"  {t}{mark}  * {who} reacted {r.get('emoji','?')} to: {frag}"
    if r["kind"] == "file":
        return (f"  {t}{mark}  * {who} sent a file: {r.get('name','?')} "
                f"({_human(r.get('size'))}) [{r.get('file_id','?')}]")
    to = f" -> {r['to']}" if r.get("to") else ""
    ch = r.get("chan") or DEFAULT_CHAN
    where = "" if r.get("to") else f" {ch}"
    mid = r.get("mid", "")
    rx = reactions(mid) if mid else {}
    tail = ("   " + " ".join(f"{e}{len(v)}" for e, v in rx.items())) if rx else ""
    tag = f"[{mid}] " if mid else ""
    if r["kind"] == "ask":
        return f"  {t}{mark} {where} {tag}[{r.get('id','?')}] QUESTION from <{who}>: {r['text']}{tail}"
    if r["kind"] == "answer":
        return f"  {t}{mark} {where} {tag}-> answer to {r.get('ref','?')} from <{who}>: {r['text']}{tail}"
    return f"  {t}{mark} {where} {tag}<{who}{to}> {r['text']}{tail}"


# --- unread counts per view --------------------------------------------
# SHARED mechanism with the UI: the /talk/api/read server writes to the same files.
# Michal sees counters in the interface; sessions must have access to them from the CLI -
# otherwise the UI knows more about the channel than its participants.
READ = os.path.join(ROOT, "read")


def rkey(view):
    return re.sub(r"[^a-zA-Z0-9#_.-]", "_", str(view))


def read_mark(who, view):
    try:
        return int(open(os.path.join(READ, who, rkey(view))).read().strip() or 0)
    except Exception:
        return 0


def set_read_mark(who, view, ts_ms=None):
    d = os.path.join(READ, who)
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, rkey(view)), "w") as f:
        f.write(str(int(ts_ms if ts_ms is not None else time.time() * 1000)))


def unread_counts(who=None):
    """{'#channel': n, 'dm:<sid>': n} - counted as in the UI, so the numbers match."""
    who = who or sid()
    msgs = [r for r in load_all() if r.get("kind") not in ("react", "join", "leave")]
    out = {}
    for c in channels():
        since = read_mark(who, c)
        out[c] = sum(1 for r in msgs if not r.get("to")
                     and (r.get("chan") or DEFAULT_CHAN) == c
                     and r.get("sid") != who and r["ts"] * 1000 > since)
    for p in glob.glob(os.path.join(PRES, "*")):
        s = os.path.basename(p)
        if s == who or s.endswith(".tmp"):
            continue
        since = read_mark(who, "dm:" + s)
        n = sum(1 for r in msgs if r.get("to") and r.get("sid") == s and r["ts"] * 1000 > since)
        if n:
            out["dm:" + s] = n
    return out


def mentions_of(who=None, unread_only=False):
    """Messages mentioning @<label>. In Slack, a mention carries more weight than
    an ordinary unread message - the same applies here: badges only for mentions and DMs."""
    who = who or sid()
    lbl = label_of(who)
    needles = {"@" + lbl.lower(), "@" + lbl.split("/")[0].lower(), "@" + short(who).lower()}
    out = []
    for r in load_all():
        if r.get("kind") in ("react", "join", "leave") or r.get("sid") == who:
            continue
        t = (r.get("text") or "").lower()
        if not any(n in t for n in needles):
            continue
        if unread_only:
            key = ("dm:" + r["sid"]) if r.get("to") else (r.get("chan") or DEFAULT_CHAN)
            if r["ts"] * 1000 <= read_mark(who, key):
                continue
        out.append(r)
    return out


PINS = os.path.join(ROOT, "pins")


def pinned():
    """Pinned messages: {mid: {'by':..., 'ts':...}}. Slack keeps them per channel;
    here a global list is enough because mid identifies the channel."""
    out = {}
    if not os.path.isdir(PINS):
        return out
    for p in glob.glob(os.path.join(PINS, "*")):
        try:
            out[os.path.basename(p)] = json.load(open(p))
        except Exception:
            pass
    return out


def search(q, chan=None, limit=40):
    ql = q.lower()
    res = []
    for r in load_all():
        if r.get("kind") in ("react", "join", "leave"):
            continue
        if chan and (r.get("chan") or DEFAULT_CHAN) != chan:
            continue
        if ql in (r.get("text") or "").lower() or ql in (r.get("label") or "").lower():
            res.append(r)
    return res[-limit:]


# --- machine health -------------------------------------------------------
# Michal repeatedly asked about VPS resources, and each time he had to ASK.
# The data is in ~/lowmem-sample.log (sampled every minute), so it just needs to be shown.
# The path is overridable so tests do not read the machine's live log - the same
# principle as TALK_HOME. Without this, a `talk health` test would depend on
# whatever the sampler collected, testing the weather rather than the code.
SAMPLE_LOG = os.environ.get("TALK_SAMPLE_LOG") or os.path.expanduser("~/lowmem-sample.log")


def health(points=60):
    """Current state + time series for a chart. Returns a dict or None."""
    try:
        with open(SAMPLE_LOG) as f:
            lines = f.readlines()[-points:]
    except Exception:
        return None
    series = []
    for l in lines:
        m = dict(re.findall(r"(\w+)=([\d.]+)", l))
        if not m:
            continue
        series.append({k: int(float(v)) for k, v in m.items()
                       if k in ("avail", "used", "swap", "fpm", "fpm_rss_max")})
    if not series:
        return None
    cur = series[-1]
    av = [p["avail"] for p in series if "avail" in p]
    return {
        "avail": cur.get("avail"), "swap": cur.get("swap"),
        "fpm": cur.get("fpm"), "worker_max": cur.get("fpm_rss_max"),
        "avail_min": min(av) if av else None,
        "avail_max": max(av) if av else None,
        "series": [p.get("avail", 0) for p in series],
        "points": len(series),
    }


def digest(who=None, since_ts=None):
    """What happened while away. Answers the question a human asks
    on returning: 'did I miss anything important?' rather than 'show me 241 messages'."""
    who = who or sid()
    msgs = [r for r in load_all() if r.get("kind") not in ("react", "join", "leave")]
    if since_ts is None:
        # Default: since the last thing THIS participant wrote.
        mine = [r["ts"] for r in msgs if r.get("sid") == who]
        since_ts = mine[-1] if mine else (time.time() - 12 * 3600)
    new = [r for r in msgs if r["ts"] > since_ts and r.get("sid") != who]
    if not new:
        return None
    by_who = {}
    for r in new:
        by_who[r.get("label") or "?"] = by_who.get(r.get("label") or "?", 0) + 1
    by_chan = {}
    for r in new:
        c = "DM" if r.get("to") else (r.get("chan") or DEFAULT_CHAN)
        by_chan[c] = by_chan.get(c, 0) + 1
    lbl = label_of(who)
    needles = {"@" + lbl.lower(), "@" + lbl.split("/")[0].lower()}
    mentions = [r for r in new
                if any(n in (r.get("text") or "").lower() for n in needles) or r.get("to")]
    return {
        "since": since_ts, "count": len(new),
        "hours": round((time.time() - since_ts) / 3600, 1),
        "by_who": sorted(by_who.items(), key=lambda x: -x[1]),
        "by_chan": sorted(by_chan.items(), key=lambda x: -x[1]),
        "mentions": mentions,
        "open": open_items(),
        "first": new[0], "last": new[-1],
    }


def cursor_path():
    return os.path.join(CURS, sid())


def read_new(advance=True):
    msgs = load_all()
    try:
        n = int(open(cursor_path()).read().strip() or 0)
    except Exception:
        n = 0
    me = sid()
    new = msgs[n:]
    if advance:
        with open(cursor_path(), "w") as f:
            f.write(str(len(msgs)))
    # Do not deliver own messages or others' messages addressed to someone else.
    out = []
    for r in new:
        if r.get("sid") == me:
            continue
        if r.get("kind") in ("join", "leave"):
            continue    # noise: every ask_nestor call produces a join+leave
        to = r.get("to")
        if to and to not in (me, short(me), label_of(me), "all"):
            continue
        out.append(r)
    return out


def who():
    prune_presence()          # clean up ended sessions before showing them
    now = time.time()
    rows = []
    for p in sorted(glob.glob(os.path.join(PRES, "*"))):
        if p.endswith(".tmp"):
            continue
        try:
            d = json.load(open(p))
        except Exception:
            continue
        s = os.path.basename(p)
        age = now - d.get("seen", 0)
        rows.append((age, s, d))
    if not rows:
        print("No one is in the channel.")
        return
    typ = fresh_in(TYPING, TYPING_TTL)
    bsy = fresh_in(BUSY, BUSY_TTL)
    # The threshold depends on session kind: a one-shot process is dead after several dozen
    # seconds of silence; a named session may simply be waiting for the next call.
    # A single threshold for both showed ended ephemeral sessions as "active" for 10 min.
    def _dead(age, d):
        return age > (EPHEMERAL_STALE if is_ephemeral(d.get("label", ""), d) else STALE_AFTER)
    live = [r for r in sorted(rows) if not _dead(r[0], r[2])]
    gone = [r for r in sorted(rows) if _dead(r[0], r[2])]
    print("Sessions in the channel:")
    if not live:
        print("  (no one active)")
    for age, s, d in live:
        if s in typ:
            state = "TYPING..."
        elif s in bsy:
            state = "working"
        elif age < ONLINE_WINDOW:
            state = "active"
        else:
            state = "quiet"
        mine = "  <- you" if s == sid() else ""
        up = int((time.time() - d.get("since", time.time())) / 60)
        print(f"  [{state:8}] {d.get('label','?'):22} {short(s)}  "
              f"last seen {int(age)}s ago, in channel for {up} min{mine}")
        if d.get("doing"):
            print(f"             doing: {d['doing']}")
        if d.get("watch"):
            print(f"             watching: {', '.join(d['watch'])}")
    if gone:
        # An ended session does not leave the channel - there is no SessionEnd for
        # a process that simply finished its work. So we do not pretend it is alive.
        print("\nLast seen (no longer working):")
        for age, s, d in gone:
            mins = int(age / 60)
            print(f"  {d.get('label','?'):22} {short(s)}  {mins} min ago")


def prune(force=False):
    """Deletion DISABLED at Michal's request (2026-07-30): keep the entire
    channel history. Without --force, this command only reports what it WOULD remove.
    MSG_TTL remains a parameter in the code, but nothing applies it automatically -
    the cron job was removed."""
    if not force:
        cut0 = time.time() - MSG_TTL
        old = [r for r in load_all() if r.get("ts", 0) < cut0]
        print(f"Deletion disabled. {len(old)} messages would be older than "
              f"{MSG_TTL//3600}h, but NOTHING is being removed. To force: talk prune --force")
        return
    cut = time.time() - MSG_TTL
    msgs = [r for r in load_all() if r.get("ts", 0) >= cut]
    with Lock():
        tmp = CHAN + ".tmp"
        with open(tmp, "w") as f:
            for r in msgs:
                f.write(json.dumps(r, ensure_ascii=False) + "\n")
        os.replace(tmp, CHAN)
    # Cursors could point beyond the end - clamp them.
    for c in glob.glob(os.path.join(CURS, "*")):
        try:
            if int(open(c).read().strip() or 0) > len(msgs):
                open(c, "w").write(str(len(msgs)))
        except Exception:
            pass
    for p in glob.glob(os.path.join(PRES, "*")):
        if time.time() - os.path.getmtime(p) > 7 * 86400:
            os.remove(p)
    print(f"ok, {len(msgs)} messages remain")


USAGE = """talk - an ephemeral channel between Claude Code sessions (NOT persistent memory; use the wiki)

  talk status               FULL channel overview in one call (start here)\n  talk health               machine health: RAM, swap, workers, chart over time\n  talk since                what happened while you were away (instead of 241 messages)
  talk unread               unread counts per channel and DM
  talk seen <#channel>      reset the counter without reading
  talk who                  who is in the channel, who is active, what they are doing
  talk say <text>           tell everyone on #general
  talk in <#channel> <text> speak in a specific channel (e.g. #infra)
  talk channels             list channels
  talk to <who> <text>      DM a specific session (label or 8-character ID)
  talk read                 new messages for me (advances the cursor)
  talk log [n]              last n messages (default 20, no cursor)

  -- topic channels: ask a CHANNEL, not a specific session --
  talk watch <#channel>     watch a channel (visible in `talk who`)
  talk unwatch <#channel>   stop watching
  talk ask <#channel> <question> ask an open question - anyone returning can pick it up
  talk open [#channel]      open unanswered questions
  talk answer <qid> <text>  answer and close a question

  -- reactions, mentions, searching, pinning --
  talk react <mid> <emoji>  attach an emoji to a message (mid is shown in `talk log`)
  talk mentions [--new]     messages mentioning @Your-name
  talk search <phrase> [#c] search channel history
  talk pin <mid> / unpin    pin / unpin a message
  talk pins                 list pinned messages
  -- files: transfer through talk's own storage (no public HTTP) --
  talk send-file <path> [--to <label>]         send a file from this VPS to the channel
  talk send-file --name <name> --stdin [--to <label>]   send bytes from STDIN (SSH)
  talk files                                     list files in storage
  talk get-file <file_id> <destination_path>   save a stored file to the VPS

  talk me <label>           name yourself (e.g. "motowolt-deploy")
  talk doing <description> say what you are working on (visible in `talk who`)
  talk ping                 heartbeat (called by hooks)
  talk prune                clean up messages older than 24h

History is NOT deleted (deletion disabled on 2026-07-30) and is NOT in git. Save facts that need to survive
to ~/second-brain (wiki) - see its CLAUDE.md."""


def main():
    a = sys.argv[1:]
    if not a:
        print(USAGE); return 1
    cmd, rest = a[0], a[1:]

    if cmd == "who":
        ping(); who()
    elif cmd == "say":
        if not rest: print("talk say: text required"); return 1
        ping(); r = post("say", " ".join(rest))
        print(f"sent as <{r['label']}>")
    elif cmd == "in":
        if len(rest) < 2: print("talk in <#channel> <text>"); return 1
        ch = rest[0] if rest[0].startswith("#") else "#" + rest[0]
        ping(); r = post("say", " ".join(rest[1:]), chan=ch)
        print(f"sent to {ch} as <{r['label']}>")
    elif cmd == "channels":
        mine = set(watched())
        for c in channels():
            op = len(open_items(c))
            mark = " *watching*" if c in mine else ""
            print(f"  {c}{mark}" + (f"  ({op} open)" if op else ""))
    elif cmd == "react":
        if len(rest) < 2: print("talk react <mid> <emoji>   (mid is shown in `talk log`)"); return 1
        mid = rest[0]
        tgt = [r for r in load_all() if r.get("mid") == mid]
        if not tgt: print(f"message {mid} not found"); return 1
        ping(); post("react", "", chan=tgt[0].get("chan") or DEFAULT_CHAN,
                     extra={"ref": mid, "emoji": rest[1]})
        who_to = tgt[0].get("label") or tgt[0].get("sid", "")[:8]
        print(f"{rest[1]} -> {mid} (from <{who_to}>)")
    elif cmd == "watch":
        if not rest: print("talk watch <#channel> [...]"); return 1
        chs = [c if c.startswith("#") else "#" + c for c in rest]
        s = sid(); p = os.path.join(PRES, s); d = ping()
        d["watch"] = sorted(set(watched()) | set(chs))
        with open(p, "w") as f: json.dump(d, f)
        print("watching: " + ", ".join(d["watch"]))
    elif cmd == "unwatch":
        chs = {c if c.startswith("#") else "#" + c for c in rest}
        s = sid(); p = os.path.join(PRES, s); d = ping()
        d["watch"] = [c for c in watched() if c not in chs]
        with open(p, "w") as f: json.dump(d, f)
        print("watching: " + (", ".join(d["watch"]) or "(none)"))
    elif cmd == "ask":
        if len(rest) < 2: print("talk ask <#channel> <question>"); return 1
        ch = rest[0] if rest[0].startswith("#") else "#" + rest[0]
        ping(); r = post("ask", " ".join(rest[1:]), chan=ch, extra={"id": "?"})
        print(f"open question {r['id']} on {ch} - anyone can answer: talk answer {r['id']} <text>")
    elif cmd == "answer":
        if len(rest) < 2: print("talk answer <id> <text>"); return 1
        qid = rest[0]
        src = [r for r in load_all() if r.get("id") == qid]
        if not src: print(f"question {qid} not found"); return 1
        ping(); post("answer", " ".join(rest[1:]),
                     chan=src[0].get("chan") or DEFAULT_CHAN, extra={"ref": qid})
        print(f"answered {qid}")
    elif cmd == "open":
        ch = (rest[0] if rest[0].startswith("#") else "#" + rest[0]) if rest else None
        items = open_items(ch)
        if not items: print("No open questions." + (f" ({ch})" if ch else "")); return 0
        print(f"{len(items)} open questions:")
        for r in items:
            age = int((time.time() - r["ts"]) / 60)
            print(f"  [{r['id']}] {r.get('chan')} from <{r.get('label')}> {age} min ago")
            print(f"        {r['text']}")
        print("\nAnswer: talk answer <id> <text>")
    elif cmd == "to":
        if len(rest) < 2: print("talk to <who> <text>"); return 1
        ping(); r = post("say", " ".join(rest[1:]), to=rest[0])
        print(f"sent to {rest[0]} as <{r['label']}>")
    elif cmd == "read":
        ping(); new = read_new(advance=True)
        if not new:
            print("No new messages.")
        else:
            print(f"{len(new)} new messages:")
            for r in new: print(fmt(r, mark=" NEW"))
    elif cmd == "log":
        args = list(rest)
        ch = next((a if a.startswith("#") else None for a in args), None)
        n = next((int(a) for a in args if a.isdigit()), 20)
        ping()
        # Reactions/joins do not get separate lines.
        msgs = [r for r in load_all() if r.get("kind") not in ("react", "join", "leave")]
        if ch:
