        for p in glob.glob(os.path.join(FILES, "*")):
            fid, _, name = os.path.basename(p).partition("__")
            rows.append((fid, name or os.path.basename(p), os.path.getsize(p), recs.get(fid)))
        if not rows:
            print("File storage is empty."); return 0
        rows.sort(key=lambda r: (r[3] or {}).get("ts", 0))
        print(f"{len(rows)} files in storage:")
        for fid, name, size, rec in rows:
            frm = (rec or {}).get("label") or "?"
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(rec["ts"])) if rec else "?"
            print(f"  [{fid}]  {name}  ({_human(size)})  from <{frm}>  {when}")
        print("\nDownload: talk get-file <file_id> <destination_path>")
    elif cmd == "get-file":
        if len(rest) < 2: print("talk get-file <file_id> <destination_path>"); return 1
        fid, dest = rest[0], rest[1]
        src = find_file(fid)
        if not src:
            print(f"file with ID {fid} not found (check `talk files`)"); return 1
        with open(src, "rb") as f:
            data = f.read()
        with open(dest, "wb") as f:
            f.write(data)
        ping(); print(f"saved {len(data)} B -> {dest}")
    elif cmd == "prune":
        prune(force="--force" in rest)
    else:
        print(USAGE); return 1
    return 0


