            print("Nothing new since your last message."); return 0
        print(f"While you were away ({d['hours']} h): {d['count']} messages")
        # "label (n)" is hard to read when the label itself has parentheses
        # ("alpha/project (2)") - hence a multiplication sign instead of parentheses.
        print("  who:    " + ", ".join(f"{k} \u00d7{v}" for k, v in d["by_who"][:5]))
        print("  where:  " + ", ".join(f"{k} \u00d7{v}" for k, v in d["by_chan"]))
