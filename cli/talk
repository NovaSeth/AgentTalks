            for r in d["open"]:
                print(f"    [{r['id']}] {r.get('chan')}: {(r.get('text') or '')[:90]}")
        print(f"\n  Latest: {fmt(d['last'])[2:170]}")
        print("\n  Full text: talk log 30")
    elif cmd == "health":
        h = health()
        if not h:
            print("No data - the sampler has not written anything yet."); return 1
        print("Machine health (last %d samples, every minute):" % h["points"])
        print(f"  RAM free      {h['avail']} MB   (min {h['avail_min']}, max {h['avail_max']})")
        print(f"  swap used     {h['swap']} MB")
        print(f"  php workers   {h['fpm']}   largest {h['worker_max']} MB RSS")
        ser = h["series"][-40:]
        if len(ser) > 2:
            lo, hi = min(ser), max(ser)
            blocks = "\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588"
            rng = max(hi - lo, 1)
            spark = "".join(blocks[min(7, (v - lo) * 8 // rng)] for v in ser)
            print(f"  RAM over time {spark}  ({lo}-{hi} MB)")
    elif cmd == "send-file":
        opts, pos, stdin_flag = {}, [], False
        i = 0
        while i < len(rest):
            a = rest[i]
            if a == "--stdin":
                stdin_flag = True; i += 1
            elif a in ("--to", "--name"):
                if i + 1 >= len(rest): print(f"talk send-file: {a} requires a value"); return 1
                opts[a] = rest[i + 1]; i += 2
            else:
                pos.append(a); i += 1
        to = opts.get("--to")
        if stdin_flag:
            name = opts.get("--name")
            if not name:
                print("talk send-file --name <name> --stdin [--to <label>]   (name required with --stdin)"); return 1
            data = sys.stdin.buffer.read()
        else:
            if not pos:
                print("talk send-file <path> [--to <label>]   or   --name <name> --stdin"); return 1
            path = pos[0]
