        ping()
        print("=== WHO IS IN THE CHANNEL ==="); who()
        u = {k: v for k, v in unread_counts().items() if v}
        print("\n=== UNREAD ===")
        if not u: print("  (none)")
        for k, v in sorted(u.items(), key=lambda x: -x[1]):
            name = label_of(k[3:]) + " (DM)" if k.startswith("dm:") else k
            print(f"  {v:>3}  {name}")
        mn = mentions_of(unread_only=True)
        print("\n=== MENTIONS (unread) ===")
        if not mn: print("  (none)")
        for r in mn: print(fmt(r))
        pn = pinned()
        if pn:
            by_mid = {x.get("mid"): x for x in load_all()}
            print("\n=== PINNED ===")
            for mid2, meta in sorted(pn.items(), key=lambda x: x[1].get("ts", 0)):
                r = by_mid.get(mid2)
                if r: print(fmt(r))
        print("\n=== CHANNELS ===")
        mine = set(watched())
        for c in channels():
            op = len(open_items(c))
            print(f"  {c}{' *watching*' if c in mine else ''}" + (f"  ({op} open)" if op else ""))
        items = open_items()
        print("\n=== OPEN QUESTIONS ===")
        if not items: print("  (none)")
        for r in items:
