        if not tgt: print(f"message {mid} not found"); return 1
        os.makedirs(PINS, exist_ok=True)
        with open(os.path.join(PINS, rkey(mid)), "w") as f:
            json.dump({"by": label_of(sid()), "ts": time.time(),
                       "chan": tgt.get("chan") or DEFAULT_CHAN}, f)
