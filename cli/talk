        # Rejestrujemy obecnosc, ale NIE pisemy do kanalu. Kazde wywolanie
        # ask_nestor to wejscie+wyjscie, wiec komunikaty byly czystym szumem -
        # stan i tak widac na zywo w liscie sesji.
        ping(label=" ".join(rest) if rest else None)
    elif cmd == "leave":
        ping()   # tylko heartbeat; obecnosc wygasa sama po 15 min ciszy
    elif cmd == "since":
        ping()
        d = digest()
        if not d:
            print("Nic nowego od Twojej ostatniej wiadomosci."); return 0
        print(f"Pod Twoją nieobecność ({d['hours']} h): {d['count']} wiadomości")
        # "etykieta (n)" jest nieczytelne, gdy etykieta sama ma nawiasy
        # ("alfa/projekt (2)") - stad krzyzyk zamiast nawiasow.
        print("  kto:    " + ", ".join(f"{k} \u00d7{v}" for k, v in d["by_who"][:5]))
        print("  gdzie:  " + ", ".join(f"{k} \u00d7{v}" for k, v in d["by_chan"]))
        if d["mentions"]:
            print(f"\n  DOTYCZY CIEBIE ({len(d['mentions'])}):")
            for r in d["mentions"][-3:]:
                print("    " + fmt(r)[2:150])
        if d["open"]:
            print(f"\n  OTWARTE PYTANIA ({len(d['open'])}):")
            for r in d["open"]:
                print(f"    [{r['id']}] {r.get('chan')}: {(r.get('text') or '')[:90]}")
        print(f"\n  Ostatnia: {fmt(d['last'])[2:170]}")
        print("\n  Cała treść: talk log 30")
    elif cmd == "health":
        h = health()
        if not h:
            print("Brak danych - sampler nie zapisal jeszcze nic."); return 1
        print("Stan maszyny (ostatnie %d probek, co minute):" % h["points"])
        print(f"  RAM wolne     {h['avail']} MB   (min {h['avail_min']}, max {h['avail_max']})")
        print(f"  swap w uzyciu {h['swap']} MB")
        print(f"  workery php   {h['fpm']}   najwiekszy {h['worker_max']} MB RSS")
        ser = h["series"][-40:]
        if len(ser) > 2:
            lo, hi = min(ser), max(ser)
            blocks = "\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588"
            rng = max(hi - lo, 1)
            spark = "".join(blocks[min(7, (v - lo) * 8 // rng)] for v in ser)
            print(f"  RAM w czasie  {spark}  ({lo}-{hi} MB)")
    elif cmd == "send-file":
        opts, pos, stdin_flag = {}, [], False
        i = 0
        while i < len(rest):
            a = rest[i]
            if a == "--stdin":
                stdin_flag = True; i += 1
            elif a in ("--to", "--name"):
                if i + 1 >= len(rest): print(f"talk send-file: {a} wymaga wartosci"); return 1
                opts[a] = rest[i + 1]; i += 2
            else:
                pos.append(a); i += 1
        to = opts.get("--to")
        if stdin_flag:
            name = opts.get("--name")
            if not name:
                print("talk send-file --name <nazwa> --stdin [--to <label>]   (nazwa wymagana przy --stdin)"); return 1
            data = sys.stdin.buffer.read()
        else:
            if not pos:
                print("talk send-file <sciezka> [--to <label>]   albo   --name <nazwa> --stdin"); return 1
            path = pos[0]
            if not os.path.isfile(path):
                print(f"nie ma pliku: {path}"); return 1
            with open(path, "rb") as f:
                data = f.read()
            name = opts.get("--name") or os.path.basename(path)
        ping(); fid = store_file(data, name, to=to)
        print(fid)
    elif cmd == "files":
        ping()
        os.makedirs(FILES, exist_ok=True)
        recs = file_records()
        rows = []
        for p in glob.glob(os.path.join(FILES, "*")):
            fid, _, name = os.path.basename(p).partition("__")
            rows.append((fid, name or os.path.basename(p), os.path.getsize(p), recs.get(fid)))
        if not rows:
            print("Magazyn plikow jest pusty."); return 0
        rows.sort(key=lambda r: (r[3] or {}).get("ts", 0))
        print(f"{len(rows)} plikow w magazynie:")
        for fid, name, size, rec in rows:
            frm = (rec or {}).get("label") or "?"
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(rec["ts"])) if rec else "?"
            print(f"  [{fid}]  {name}  ({_human(size)})  od <{frm}>  {when}")
        print("\nPobierz: talk get-file <file_id> <sciezka_docelowa>")
    elif cmd == "get-file":
        if len(rest) < 2: print("talk get-file <file_id> <sciezka_docelowa>"); return 1
        fid, dest = rest[0], rest[1]
        src = find_file(fid)
        if not src:
            print(f"nie ma pliku o id {fid} (sprawdz `talk files`)"); return 1
        with open(src, "rb") as f:
            data = f.read()
        with open(dest, "wb") as f:
            f.write(data)
        ping(); print(f"zapisane {len(data)} B -> {dest}")
    elif cmd == "prune":
        prune(force="--force" in rest)
    else:
        print(USAGE); return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
