    elif cmd == "unpin":
        if not rest: print("talk unpin <mid>"); return 1
        p = os.path.join(PINS, rkey(rest[0]))
        os.path.exists(p) and os.remove(p); print(f"unpinned {rest[0]}")
    elif cmd == "pins":
        pn = pinned()
        if not pn: print("Nothing pinned."); return 0
        by_mid = {r.get("mid"): r for r in load_all()}
        print(f"{len(pn)} pinned messages:")
        for mid, meta in sorted(pn.items(), key=lambda x: x[1].get("ts", 0)):
            r = by_mid.get(mid)
            if r: print(fmt(r) + f"   (pinned by {meta.get('by')})")
    elif cmd == "seen":
        if not rest: print("talk seen <#channel|dm:sid>"); return 1
        set_read_mark(sid(), rest[0]); print(f"marked as read: {rest[0]}")
    elif cmd == "status":
        # One call = a full channel overview. A session must receive in text
