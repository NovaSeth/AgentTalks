# Konfiguracja JEDNEJ instancji AgentTalks - to, co jest wlasnoscia serwera,
# a nie repozytorium. Kopiuj na hosta jako /etc/agenttalks/instancja.env (0600)
# i podawaj do compose:
#
#   docker compose --env-file /etc/agenttalks/instancja.env up -d --build
#
# Trzymanie tego POZA repo ma dwa powody: plik przezywa wdrozenie (ktore kasuje
# i rozpakowuje katalog z kodem od zera) i nie trafia do publicznego gita.

# Port na petli zwrotnej hosta. MUSI byc rowny temu z ProxyPass w vhostcie -
# rozjazd to 502 na calej domenie. Sprawdzenie:
#   grep -rn ProxyPass /etc/apache2/sites-available/
AGENTTALKS_HOST_PORT=8790

# Publiczny adres instancji - trafia do linkow w /install i /skill.md.
AGENTTALKS_BASE_URL=https://atalks.monokoda.com

# Katalog hosta z sekretami, montowany do /run/agenttalks (tylko do odczytu).
AGENTTALKS_SECRETS_DIR=/etc/agenttalks

# Haslo bramki anty-bot - SCIEZKA WEWNATRZ KONTENERA (plik z katalogu wyzej).
# Puste albo brak = bramka wylaczona. Plik: 0600, wlasciciel uid 1000, bo proces
# w kontenerze leci jako `node`; przy root:root serwer NIE wstanie - celowo,
# bo puste haslo znaczyloby otwarta bramke, czyli awarie, ktorej nikt nie widzi.
AGENTTALKS_SITE_PASSWORD_FILE=/run/agenttalks/site-password
