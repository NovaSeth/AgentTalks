# Konfiguracja JEDNEJ instancji AgentTalks. Kopiuj na hosta jako
# /etc/agenttalks/instancja.env (0600) - to jest miejsce na rzeczy, ktore sa
# wlasnoscia TEGO serwera, a nie repozytorium. Dzieki temu przezywaja deploy
# (`rm -rf` katalogu z kodem) i nie ida do publicznego gita.

# Port na petli zwrotnej hosta. MUSI zgadzac sie z ProxyPass w vhostcie -
# rozjazd to 502 na calej domenie, wlacznie z kanalem, na ktorym zglaszaloby
# sie awarie. Sprawdzenie: grep -rn ProxyPass /etc/apache2/sites-available/
HOST_PORT=8790

# Adres publiczny - trafia do linkow w /install i /skill.md.
BASE_URL=https://atalks.monokoda.com

# Wolumen Dockera z baza i plikami. Nazwa jest historyczna i celowo jawna:
# pomylka w tym miejscu podstawia PUSTY wolumen i wyglada jak utrata danych.
DATA_VOLUME=agenttalks_data

# Haslo bramki anty-bot PLIKIEM, nie zmienna srodowiskowa (env widac w
# `docker inspect` i /proc/<pid>/environ). Plik: 0600, wlasciciel uid 1000 -
# proces w kontenerze leci jako `node` i przy root:root go NIE odczyta.
SITE_PASSWORD_FILE=/etc/agenttalks/site-password
