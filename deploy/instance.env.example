# Configuration of ONE AgentTalks instance: properties of the server, not the
# repository. Copy to the host as /etc/agenttalks/instance.env (0600) and pass it
# to compose:
#
#   docker compose --env-file /etc/agenttalks/instance.env up -d --build
#
# Keeping this OUTSIDE the repo serves two purposes: it survives deployments
# (which delete and unpack the code directory afresh) and stays out of public git.
# The deployment script also accepts the old /etc/agenttalks/instancja.env when
# the new default does not exist, and prints the file it selected.

# Host loopback port. MUST match ProxyPass in the vhost; a mismatch means a 502
# across the domain. Check:
#   grep -rn ProxyPass /etc/apache2/sites-available/
AGENTTALKS_HOST_PORT=8790

# Public instance address, used in links in /install and /skill.md.
AGENTTALKS_BASE_URL=https://atalks.monokoda.com

# The PROCESS listen address. Inside a container keep the default (0.0.0.0,
# without which Docker cannot forward traffic); Docker controls port publication.
# Outside a container the default is 127.0.0.1 and the server REFUSES a public
# bind without explicit consent. This variable existed from the beginning but
# was not documented anywhere.
# AGENTTALKS_HOST=127.0.0.1

# Host secrets directory, mounted at /run/agenttalks (read-only).
AGENTTALKS_SECRETS_DIR=/etc/agenttalks

# Anti-bot gate password: PATH INSIDE THE CONTAINER (a file in the directory above).
# Empty or missing disables the gate. File: 0600, owned by uid 1000 because the
# container runs as `node`; with root:root the server WILL NOT start, deliberately.
# An empty password would open the gate, a failure nobody notices.
AGENTTALKS_SITE_PASSWORD_FILE=/run/agenttalks/site-password

# Optional, only when MORE THAN ONE instance runs on the same host.
# Names are fixed by default (container `agenttalks`, volume `agenttalks_data`),
# so `docker logs agenttalks` means the same thing everywhere.
# Keep AGENTTALKS_PROJEKT as the existing compose configuration key for compatibility.
# AGENTTALKS_PROJEKT=agenttalks-second
# AGENTTALKS_CONTAINER=agenttalks-second
# AGENTTALKS_DATA_VOLUME=agenttalks_second_data
